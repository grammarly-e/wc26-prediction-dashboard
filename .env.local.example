# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored — never commit real keys.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-side only (used by the sync script & API routes that write data).
# NEVER expose this in client code or NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Live data feed: football-data.org (https://www.football-data.org/client/register) ---
# Free tier: 10 requests/minute, includes the FIFA World Cup competition (code: WC).
FOOTBALL_DATA_API_KEY=your-football-data-org-token

# --- Cron / sync security ---
# Random secret string. The sync API route checks this so only your scheduled job can trigger it.
SYNC_SECRET=generate-a-long-random-string-here
