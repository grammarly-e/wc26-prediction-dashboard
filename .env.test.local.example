# ============================================================================
# TEST environment template — copy this to .env.test.local and fill in the
# credentials of a SEPARATE Supabase project (not the one in .env.local).
#
# .env.test.local is git-ignored (see .gitignore's "# local env files" block,
# which matches .env*.local), exactly like .env.local — never commit real keys
# for either environment.
#
# Full setup walkthrough: TESTING_ENVIRONMENT.md
# ============================================================================

# --- Supabase (Project Settings > API) — your TEST project, NOT production ---
# Create a brand-new free-tier project at https://supabase.com/dashboard for
# this. Using the same project as .env.local defeats the entire point of this
# file — the seed/clear scripts will refuse to run if the URLs match, but
# double-check anyway.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-TEST-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-test-project-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-test-project-service-role-key

# --- Not needed for testing ---
# The fake-data scripts write directly to the test database — they don't call
# football-data.org, and the test project should never run the live sync job
# (there's nothing to sync; it's not a real tournament feed). Leave these unset.
# FOOTBALL_DATA_API_KEY=
# SYNC_SECRET=
